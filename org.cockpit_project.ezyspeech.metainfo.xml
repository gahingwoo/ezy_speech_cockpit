<?xml version="1.0" encoding="UTF-8"?>
<component type="addon">
    <id>org.gahingwoo.ezyspeech</id>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>AGPL-3.0-or-later</project_license>

    <name>EzySpeech</name>

    <summary>Run EzySpeech, live speech translation, from Cockpit</summary>

    <description>
        <p>
            Shows whether EzySpeech is running and where to open it, installs
            its updates and rolls them back, sets the admin password, makes
            backups and reads the log, for an install on the machine or in
            Docker.
        </p>
    </description>

    <extends>org.cockpit_project.cockpit</extends>

    <launchable type="cockpit-manifest">ezyspeech</launchable>

    <url type="homepage">https://github.com/gahingwoo/ezy_speech_cockpit</url>
    <url type="bugtracker">https://github.com/gahingwoo/ezy_speech_cockpit/issues</url>

